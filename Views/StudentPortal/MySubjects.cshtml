@model IEnumerable<SchoolManagement.Models.Subject>

@{
    ViewData["Title"] = "My Subjects";
}

<div class="page-header">
    <h1 class="page-title">My Subjects</h1>
    <p class="page-subtitle">@(ViewBag.ClassName != null ? $"Class: {ViewBag.ClassName}" : "Subjects assigned to your class")</p>
</div>

@if (!Model.Any())
{
    <div class="panel">
        <div class="panel-body">
            <p class="empty-state">No subjects assigned to your class yet.</p>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Subject</th>
                <th>Code</th>
                <th>Teacher(s)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in Model)
            {
                <tr>
                    <td>@subject.Name</td>
                    <td>@subject.Code</td>
                    <td>@string.Join(", ", subject.SubjectTeachers.Select(st => st.Teacher!.FullName))</td>
                </tr>
            }
        </tbody>
    </table>
}

@model IEnumerable<SchoolManagement.Models.Exam>

@{
    ViewData["Title"] = "Exam Questions";
    var submissions = (Dictionary<int, SchoolManagement.Models.ExamSubmission>)ViewBag.Submissions;
    var now = (DateTime)ViewBag.Now;
}

<div class="page-header">
    <h1 class="page-title">Exam Questions</h1>
    <p class="page-subtitle">Exams available to you</p>
</div>

@if (TempData["ExamError"] != null)
{
    <div class="alert alert-danger">@TempData["ExamError"]</div>
}

@if (!Model.Any())
{
    <div class="panel">
        <div class="panel-body">
            <p class="empty-state">No exams are available right now.</p>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Subject</th>
                <th>Title</th>
                <th>Starts</th>
                <th>Duration</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exam in Model)
            {
                <tr>
                    <td>@exam.Subject?.Name</td>
                    <td>@exam.Title</td>
                    <td>@(exam.StartDate != null ? exam.StartDate.Value.ToString("ddd d MMM yyyy, h:mm tt") : "—")</td>
                    <td>@(exam.DurationMinutes != null ? SchoolManagement.Services.ExamNotices.Duration(exam.DurationMinutes.Value) : "—")</td>
                    <td>
                        @if (submissions.TryGetValue(exam.Id, out var submission))
                        {
                            if (submission.AwaitingMarking)
                            {
                                <span class="status-badge status-pending">Awaiting marking (@submission.Score/@submission.OutOf so far)</span>
                            }
                            else
                            {
                                <span class="status-badge status-done">Score: @submission.Score/@submission.OutOf</span>
                            }
                        }
                        else if (exam.HasNotStarted(now))
                        {
                            <span class="status-badge status-pending">Opens @exam.StartDate!.Value.ToString("d MMM, h:mm tt")</span>
                        }
                        else if (exam.HasEnded(now))
                        {
                            <span class="status-badge status-overdue">Closed</span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-primary" asp-action="TakeExam" asp-route-examId="@exam.Id">Take Exam</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

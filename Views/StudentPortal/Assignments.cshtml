@model IEnumerable<SchoolManagement.Models.AssignmentSubmission>

@{
    ViewData["Title"] = "Assignments";
}

<div class="page-header">
    <h1 class="page-title">Assignments</h1>
    <p class="page-subtitle">Assignments given to you</p>
</div>

@if (!Model.Any())
{
    <div class="panel">
        <div class="panel-body">
            <p class="empty-state">No assignments yet.</p>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Subject</th>
                <th>Title</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Grade</th>
                <th>Feedback</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Assignment?.Subject?.Name ?? "—")</td>
                    <td>
                        @item.Assignment?.Title
                        @if (!string.IsNullOrWhiteSpace(item.Assignment?.Description))
                        {
                            <div class="text-muted small">@item.Assignment.Description</div>
                        }
                    </td>
                    <td>@item.Assignment?.DueDate.ToShortDateString()</td>
                    <td><span class="status-badge status-@item.Status.ToLower().Replace(" ", "-")">@item.Status</span></td>
                    <td>@(item.Grade != null ? $"{item.Grade}%" : "—")</td>
                    <td>@(item.Feedback ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

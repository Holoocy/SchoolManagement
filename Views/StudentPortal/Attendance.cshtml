@model IEnumerable<SchoolManagement.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Attendance";
}

<div class="page-header">
    <h1 class="page-title">Attendance</h1>
    <p class="page-subtitle">@ViewBag.AttendanceRate% present overall</p>
</div>

@if (!Model.Any())
{
    <div class="panel">
        <div class="panel-body">
            <p class="empty-state">No attendance records yet.</p>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AttendanceDate.ToShortDateString()</td>
                    <td><span class="status-badge status-@item.Status.ToLower().Replace(" ", "-")">@item.Status</span></td>
                    <td>@item.Remarks</td>
                </tr>
            }
        </tbody>
    </table>
}

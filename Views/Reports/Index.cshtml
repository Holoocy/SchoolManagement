@model SchoolManagement.Models.ReportsViewModel

@{
    ViewData["Title"] = "Reports";
    var hasAttendance = Model.AttendanceLastSevenDays.Any(day => day.Total > 0);
    var maximumAttendance = Math.Max(1, Model.AttendanceLastSevenDays.Max(day => day.Total));
}

<div class="reports-page">
    <header class="reports-header">
        <div>
            <p class="reports-eyebrow">Executive overview</p>
            <h1>School reports</h1>
            <p>A clear view of the people, learning activity, and attendance shaping your school this week.</p>
        </div>
        <span class="reports-period"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M7 3v4M17 3v4M3.5 9.5h17" stroke-linecap="round" /></svg> Last 7 days</span>
    </header>

    <section class="reports-hero" aria-labelledby="reports-hero-heading">
        <div class="reports-attendance-score">
            <span class="reports-score-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13h3l2-6 4 11 2-5h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="reports-score-value">@Model.OverallAttendanceRate<small>%</small></span>
            <strong>Attendance rate</strong>
            <span>Based on recorded attendance in the last 7 days</span>
        </div>
        <div class="reports-hero-copy">
            <p class="reports-eyebrow">At a glance</p>
            <h2 id="reports-hero-heading">Your school’s activity, in one considered view.</h2>
            <p>Track the foundation of your school community and quickly move into the work that needs attention.</p>
            <div class="reports-hero-actions">
                <a asp-controller="Attendance" asp-action="Index">Review attendance <span aria-hidden="true">→</span></a>
                <a asp-controller="Assignments" asp-action="Index">Manage assignments <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    <section class="reports-metrics" aria-label="School totals">
        <article class="reports-metric-card">
            <span class="reports-metric-icon students" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg></span>
            <div><small>Students</small><strong>@Model.TotalStudents</strong><span>Enrolled learners</span></div>
        </article>
        <article class="reports-metric-card">
            <span class="reports-metric-icon teachers" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="7" r="3.5" /><path d="M2.5 20v-1.5A4.5 4.5 0 0 1 7 14h4a4.5 4.5 0 0 1 4.5 4.5V20M17 4a3 3 0 0 1 0 5.8M21.5 20v-1.2a4.4 4.4 0 0 0-2.7-4.05" stroke-linecap="round" /></svg></span>
            <div><small>Teachers</small><strong>@Model.TotalTeachers</strong><span>Teaching staff</span></div>
        </article>
        <article class="reports-metric-card">
            <span class="reports-metric-icon subjects" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" /></svg></span>
            <div><small>Subjects</small><strong>@Model.TotalSubjects</strong><span>Active curriculum</span></div>
        </article>
        <article class="reports-metric-card">
            <span class="reports-metric-icon assignments" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M9 13h6M9 17h4" stroke-linecap="round" /></svg></span>
            <div><small>Assignments</small><strong>@Model.TotalAssignments</strong><span>Learning activities</span></div>
        </article>
    </section>

    <div class="reports-content-grid">
        <section class="reports-card reports-attendance-card" aria-labelledby="attendance-heading">
            <div class="reports-card-header">
                <div><p class="reports-card-kicker">Attendance</p><h2 id="attendance-heading">Last seven days</h2></div>
                <span class="reports-card-meta">Daily recorded presence</span>
            </div>

            @if (!hasAttendance)
            {
                <div class="reports-empty-state">
                    <span aria-hidden="true">+</span>
                    <div><h3>Attendance records will appear here</h3><p>Start recording attendance to see daily participation and trends.</p></div>
                </div>
            }
            else
            {
                <div class="reports-chart" role="img" aria-label="Attendance records for the last seven days">
                    @foreach (var day in Model.AttendanceLastSevenDays)
                    {
                        var barHeight = Math.Max(8m, Math.Round(day.Total * 100m / maximumAttendance, 0));
                        <div class="reports-chart-column">
                            <span class="reports-chart-value">@(day.Total > 0 ? $"{day.Rate:0.#}%" : "—")</span>
                            <div class="reports-chart-track"><span class="@(day.Rate >= 75 ? "is-healthy" : day.Total == 0 ? "is-empty" : "is-attention")" style="height:@barHeight%"></span></div>
                            <strong>@day.Date.ToString("ddd")</strong>
                            <small>@day.Date.ToString("MMM d")</small>
                        </div>
                    }
                </div>
                <div class="reports-attendance-legend"><span><i class="healthy"></i> 75% and above</span><span><i class="attention"></i> Below 75%</span><span><i class="empty"></i> No record</span></div>
            }
        </section>

        <section class="reports-card reports-work-card" aria-labelledby="work-heading">
            <div class="reports-card-header">
                <div><p class="reports-card-kicker">Work in motion</p><h2 id="work-heading">Assignments and checklists</h2></div>
                <span class="reports-work-total">@Model.TotalAssignments + @Model.TotalWeeklyChecklists</span>
            </div>

            <div class="reports-breakdown-section">
                <div class="reports-breakdown-heading"><span>Assignments</span><a asp-controller="Assignments" asp-action="Index">View all</a></div>
                @if (!Model.AssignmentStatusBreakdown.Any())
                {
                    <p class="reports-inline-empty">No assignments created yet.</p>
                }
                else
                {
                    <ul class="reports-breakdown-list">
                        @foreach (var status in Model.AssignmentStatusBreakdown)
                        {
                            <li><span><i class="status-@status.Status.ToLower().Replace(" ", "-")"></i>@status.Status</span><strong>@status.Count</strong></li>
                        }
                    </ul>
                }
            </div>

            <div class="reports-breakdown-section">
                <div class="reports-breakdown-heading"><span>Weekly checklist</span><a asp-controller="WeeklyChecklist" asp-action="Index">View all</a></div>
                @if (!Model.WeeklyChecklistStatusBreakdown.Any())
                {
                    <p class="reports-inline-empty">No checklist items created yet.</p>
                }
                else
                {
                    <ul class="reports-breakdown-list">
                        @foreach (var status in Model.WeeklyChecklistStatusBreakdown)
                        {
                            <li><span><i class="status-@status.Status.ToLower().Replace(" ", "-")"></i>@status.Status</span><strong>@status.Count</strong></li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>

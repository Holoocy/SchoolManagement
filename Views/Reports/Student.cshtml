@model SchoolManagement.Models.StudentRecordViewModel
@{
    ViewData["Title"] = "Student Report";
    var st = Model.Student;
}

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-action="Results" asp-route-classId="@st.ClassId" asp-route-term="@Model.Term" class="btn btn-outline-secondary btn-sm">Back to broadsheet</a>
    <a asp-controller="Students" asp-action="Details" asp-route-id="@st.Id" asp-route-term="@Model.Term" class="btn btn-outline-secondary btn-sm">Student profile</a>
</div>

<div class="d-flex align-items-center gap-3 mb-3">
    @if (!string.IsNullOrEmpty(st.PhotoPath))
    {
        <img src="@st.PhotoPath" alt="" style="width:64px;height:64px;object-fit:cover;border-radius:50%;" />
    }
    <div>
        <h2 class="mb-0">@st.FullName</h2>
        <p class="text-muted mb-0">@st.AdmissionNumber &middot; @(st.Class?.Name ?? "No grade")@(st.IsActive ? "" : " · Inactive")</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <partial name="_StudentRecord" model="Model" />
    </div>
</div>

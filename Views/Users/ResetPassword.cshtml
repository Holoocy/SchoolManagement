@model SchoolManagement.Models.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Reset Password</h2>
<p class="text-muted">Set a new password for <strong>@ViewBag.UserName</strong>.</p>

<form asp-action="ResetPassword" method="post" style="max-width: 420px;">
    <input type="hidden" asp-for="UserId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autofocus />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Reset Password</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

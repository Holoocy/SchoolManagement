@model SchoolManagement.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Student directory</p><h1>Edit student</h1><p>Maintain the student’s profile, contact details, and school placement.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to students</a></header>
    <form method="post" asp-action="Edit" enctype="multipart/form-data" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="student-profile-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="student-profile-heading">Student profile</h2><p>Update the student identity details and optional passport photo.</p></div></div><div class="entity-form-profile-grid"><div class="entity-form-upload-panel entity-form-photo-panel">@if (!string.IsNullOrEmpty(Model.PhotoPath)){<img src="@Model.PhotoPath" alt="Current student photo" class="entity-form-current-photo" />}<label for="photoFile" class="form-label">Passport Photo</label><input type="file" name="photoFile" id="photoFile" class="form-control" accept="image/*" /><small>Choose a new image only when replacing the current photo.</small></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus /><span asp-validation-for="FirstName" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="AdmissionNumber" class="form-label"></label><input asp-for="AdmissionNumber" class="form-control" /><span asp-validation-for="AdmissionNumber" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="field-validation-error"></span></div><fieldset class="entity-form-field entity-form-choice-field entity-form-field--wide"><legend class="form-label">Gender</legend><div class="entity-form-choice-group"><label><input type="radio" name="Gender" id="genderMale" value="Male" autocomplete="off" checked="@(Model?.Gender == "Male" ? "checked" : null)" /><span>Male</span></label><label><input type="radio" name="Gender" id="genderFemale" value="Female" autocomplete="off" checked="@(Model?.Gender == "Female" ? "checked" : null)" /><span>Female</span></label></div><span asp-validation-for="Gender" class="field-validation-error"></span></fieldset></div></div></section>
        <section class="entity-form-section" aria-labelledby="student-contact-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="student-contact-heading">Contact details</h2><p>Keep family contact information available to school staff.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="field-validation-error"></span></div><div class="entity-form-field entity-form-field--wide"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" autocomplete="street-address" rows="4"></textarea><span asp-validation-for="Address" class="field-validation-error"></span></div></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="student-placement-heading"><div class="entity-form-section-heading"><span>03</span><div><h2 id="student-placement-heading">School placement</h2><p>Set the current class, academic calendar, enrollment date, and activity status.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="ClassId" class="form-label"></label><select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes">@if (User.IsInRole("Admin")) {<option value="">-- Unassigned --</option>}</select><span asp-validation-for="ClassId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="AcademicCalendar" class="form-label"></label><select asp-for="AcademicCalendar" class="form-select"><option value="">-- Select --</option><option value="1st Semester">1st Semester</option><option value="2nd Semester">2nd Semester</option><option value="1st Term">1st Term</option><option value="2nd Term">2nd Term</option><option value="3rd Term">3rd Term</option><option value="Winter">Winter</option><option value="Summer">Summer</option><option value="Spring">Spring</option><option value="Fall">Fall</option><option value="Autumn">Autumn</option></select></div><div class="entity-form-field"><label asp-for="EnrollmentDate" class="form-label"></label><input asp-for="EnrollmentDate" class="form-control" /><span asp-validation-for="EnrollmentDate" class="field-validation-error"></span></div><label class="entity-form-active-option"><input asp-for="IsActive" class="form-check-input" /><span><strong>Active student</strong><small>Enable access to school activities.</small></span></label></div></section>
        <footer class="entity-form-actions"><span>Changes are applied to this student’s school record.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

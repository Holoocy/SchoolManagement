@model IEnumerable<SchoolManagement.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">Students</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Student</a>
</div>

@if (TempData["StudentSuccess"] != null)
{
    <div class="alert alert-success">@TempData["StudentSuccess"]</div>
}

<form method="get" class="mb-3">
    <div class="input-group" style="max-width: 360px;">
        <input type="text" name="search" class="form-control" placeholder="Search by name or admission no." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    var isSearching = !string.IsNullOrWhiteSpace(ViewBag.Search as string);
    @await Html.PartialAsync("_ClassicEmptyState", new SchoolManagement.Models.EmptyStateViewModel
    {
        Title = isSearching ? "No students match your search" : "Your student directory is ready",
        Description = isSearching ? "Try another name or admission number, or clear your search to see all students." : "Add your first student to begin building your school community.",
        Action = isSearching ? "Index" : "Create",
        ActionText = isSearching ? "Clear search" : "Add your first student"
    })
}
else
{
<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th></th>
            <th>Admission No.</th>
            <th>Name</th>
            <th>Class</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                    {
                        <img src="@item.PhotoPath" alt="" style="width:36px;height:36px;object-fit:cover;border-radius:50%;" />
                    }
                    else
                    {
                        <span class="topbar-user-avatar">@item.FirstName.Substring(0,1)</span>
                    }
                </td>
                <td>@item.AdmissionNumber</td>
                <td>@item.FullName</td>
                <td>@(item.Class?.Name ?? "—")</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">View</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Transfer" asp-route-id="@item.Id">Transfer</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="IdCard" asp-route-id="@item.Id">ID Card</a>
                    <form method="post" asp-action="ToggleActive" asp-route-id="@item.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning">@(item.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
}

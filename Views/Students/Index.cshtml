@model IEnumerable<SchoolManagement.Models.Student>

@{
    var isTeacher = ViewBag.IsTeacher == true;
    var hasGrades = ViewBag.HasGrades == true;
    int? classId = ViewBag.ClassId;
    ViewData["Title"] = isTeacher ? "My Students" : "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (isTeacher)
        {
            <p class="text-muted small mb-0">Students in the grade(s) assigned to you.</p>
        }
    </div>
    @if (hasGrades)
    {
        <div class="d-flex gap-2 flex-wrap">
            @if (isTeacher)
            {
                <a class="btn btn-outline-secondary" asp-controller="TeacherPortal" asp-action="ImportStudents" asp-route-classId="@classId">Import CSV</a>
            }
            else
            {
                <a class="btn btn-outline-secondary" asp-action="ImportStudents">Import CSV</a>
            }
            <a class="btn btn-primary" asp-action="Create" asp-route-classId="@classId">Add Student</a>
        </div>
    }
</div>

@if (TempData["StudentSuccess"] != null)
{
    <div class="alert alert-success">@TempData["StudentSuccess"]</div>
}
@if (TempData["StudentError"] != null)
{
    <div class="alert alert-danger">@TempData["StudentError"]</div>
}
@if (isTeacher && !hasGrades)
{
    <div class="alert alert-info">No grade has been assigned to you yet. Ask an administrator to assign one, then your students will appear here.</div>
}

<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <div class="input-group" style="max-width: 360px;">
        <input type="text" name="search" class="form-control" placeholder="Search by name or admission no." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    <div style="min-width: 220px;">
        <select name="classId" class="form-select" asp-items="ViewBag.Classes" onchange="this.form.submit()" aria-label="Filter by grade">
            <option value="">@(isTeacher ? "All my grades" : "All grades")</option>
        </select>
    </div>
</form>

@if (!Model.Any())
{
    var isSearching = !string.IsNullOrWhiteSpace(ViewBag.Search as string) || classId != null;
    @await Html.PartialAsync("_ClassicEmptyState", new SchoolManagement.Models.EmptyStateViewModel
    {
        Title = isSearching ? "No students match your search" : "Your student directory is ready",
        Description = isSearching ? "Try another name, admission number or grade, or clear your search to see all students." : isTeacher ? "Enroll a student into one of your grades to get started." : "Add your first student to begin building your school community.",
        Action = isSearching ? "Index" : "Create",
        ActionText = isSearching ? "Clear search" : "Add your first student"
    })
}
else
{
<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th></th>
            <th>Admission No.</th>
            <th>Name</th>
            <th>Class</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                    {
                        <img src="@item.PhotoPath" alt="" style="width:36px;height:36px;object-fit:cover;border-radius:50%;" />
                    }
                    else
                    {
                        <span class="topbar-user-avatar">@item.FirstName.Substring(0,1)</span>
                    }
                </td>
                <td>@item.AdmissionNumber</td>
                <td>@item.FullName</td>
                <td>@(item.Class?.Name ?? "—")</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">View</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">More</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Transfer" asp-route-id="@item.Id">Transfer</a></li>
                            <li><a class="dropdown-item" asp-action="IdCard" asp-route-id="@item.Id">ID Card</a></li>
                            <li>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@item.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
}

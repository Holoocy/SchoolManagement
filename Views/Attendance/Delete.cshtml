@model SchoolManagement.Models.AttendanceRecord

@{
    ViewData["Title"] = "Delete Attendance";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Delete Attendance</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this attendance record?</strong>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">@Model.Student?.FullName</dd>
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.AttendanceDate.ToShortDateString()</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

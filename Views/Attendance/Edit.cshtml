@model SchoolManagement.Models.AttendanceRecord

@{
    ViewData["Title"] = "Edit Attendance";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Attendance register</p><h1>Edit attendance</h1><p>Correct the student record, date, attendance status, or staff remarks.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to attendance</a></header>
    <form method="post" asp-action="Edit" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="attendance-record-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="attendance-record-heading">Attendance record</h2><p>Confirm who the record belongs to and the date it applies to.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="StudentId" class="form-label"></label><select asp-for="StudentId" class="form-select" asp-items="ViewBag.Students"></select><span asp-validation-for="StudentId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="AttendanceDate" class="form-label"></label><input asp-for="AttendanceDate" class="form-control" /><span asp-validation-for="AttendanceDate" class="field-validation-error"></span></div></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="attendance-status-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="attendance-status-heading">Status and remarks</h2><p>Record the student’s attendance outcome and any useful context.</p></div></div><div class="entity-form-grid"><fieldset class="entity-form-field entity-form-field--wide entity-form-choice-field"><legend class="form-label">Status</legend><div class="entity-form-choice-group entity-form-choice-group--four"><label><input type="radio" name="Status" id="statusPresent" value="Present" autocomplete="off" checked="@(Model.Status == "Present" ? "checked" : null)" /><span>Present</span></label><label><input type="radio" name="Status" id="statusAbsent" value="Absent" autocomplete="off" checked="@(Model.Status == "Absent" ? "checked" : null)" /><span>Absent</span></label><label><input type="radio" name="Status" id="statusLate" value="Late" autocomplete="off" checked="@(Model.Status == "Late" ? "checked" : null)" /><span>Late</span></label><label><input type="radio" name="Status" id="statusExcused" value="Excused" autocomplete="off" checked="@(Model.Status == "Excused" ? "checked" : null)" /><span>Excused</span></label></div><span asp-validation-for="Status" class="field-validation-error"></span></fieldset><div class="entity-form-field entity-form-field--wide"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="4"></textarea><span asp-validation-for="Remarks" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>Changes update the attendance register immediately.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

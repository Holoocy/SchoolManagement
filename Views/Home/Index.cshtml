@{
    ViewData["Title"] = "SchoolManagement";
}

<div class="container mt-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold mb-3">SchoolManagement</h1>
            <p class="text-muted mb-4">A dedicated home for your school &mdash; students, teachers, subjects, attendance, assignments and grades, all in one place.</p>

            <div class="d-flex justify-content-center gap-3 mb-5">
                <a asp-controller="Onboard" asp-action="Index" class="btn btn-primary btn-lg">Onboard Your School</a>
            </div>

            <div class="card mx-auto" style="max-width: 480px;">
                <div class="card-body">
                    <h5 class="card-title">Already onboarded?</h5>
                    <p class="text-muted small">Visit your school's own address to sign in &mdash; it looks like:</p>
                    <code>yourapp.com/your-school-slug</code>
                </div>
            </div>
        </div>
    </div>
</div>

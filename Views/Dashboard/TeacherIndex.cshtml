@model SchoolManagement.Models.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    string Plural(int n, string word) => n == 1 ? $"1 {word}" : $"{n} {word}s";
}

<div class="page-header">
    <h1 class="page-title">Welcome, @Model.TeacherName</h1>
    <p class="page-subtitle">Your students, subjects, exams and assignment activity</p>
</div>

@if (!Model.HasTeacherProfile)
{
    <div class="alert alert-warning">Your account isn't linked to a teacher profile yet, so there's nothing to show. Ask an administrator to link your login to your teacher record.</div>
}
else if (!Model.Classes.Any() || !Model.Subjects.Any())
{
    <div class="alert alert-info">
        @(!Model.Classes.Any() && !Model.Subjects.Any() ? "No grade or subject has" : !Model.Classes.Any() ? "No grade has" : "No subject has")
        been assigned to you yet. Ask an administrator to assign one so your students, exams and assignments appear here.
    </div>
}

<div class="stat-grid">
    <a class="stat-card stat-card-link" asp-controller="Students" asp-action="Index">
        <div class="stat-icon stat-icon-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-value">@Model.ActiveStudents</div>
        <div class="stat-label">My Students <span class="stat-sub">@(Model.InactiveStudents > 0 ? $"{Model.InactiveStudents} inactive" : "all active")</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="Students" asp-action="Index">
        <div class="stat-icon stat-icon-teal">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        </div>
        <div class="stat-value">@Model.Classes.Count</div>
        <div class="stat-label">My Grades <span class="stat-sub">@(Model.Classes.Any() ? string.Join(", ", Model.Classes.Select(c => c.Name)) : "none assigned")</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="TeacherPortal" asp-action="MySubjects">
        <div class="stat-icon stat-icon-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div class="stat-value">@Model.Subjects.Count</div>
        <div class="stat-label">My Subjects <span class="stat-sub">@(Model.Subjects.Any() ? string.Join(", ", Model.Subjects.Select(s => s.Name)) : "none assigned")</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="Attendance" asp-action="Create">
        <div class="stat-icon stat-icon-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
        </div>
        <div class="stat-value">@Model.MarkedToday / @Model.ActiveStudents</div>
        <div class="stat-label">Attendance Today <span class="stat-sub">@(Model.MarkedToday == 0 ? "not taken yet" : $"{Model.PresentToday} present")</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="Exams" asp-action="Index">
        <div class="stat-icon stat-icon-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <div class="stat-value">@Model.TotalExams</div>
        <div class="stat-label">My Exams
            <span class="stat-sub">
                @if (Model.ExamAnswersToMark > 0) { @($"{Plural(Model.ExamAnswersToMark, "answer")} to mark") }
                else if (Model.ExamsNeedingAction > 0) { @($"{Model.ExamsNeedingAction} draft/rejected") }
                else if (Model.ExamsAwaitingApproval > 0) { @($"{Model.ExamsAwaitingApproval} awaiting approval") }
                else { @("nothing to do") }
            </span>
        </div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="Assignments" asp-action="Index">
        <div class="stat-icon stat-icon-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </div>
        <div class="stat-value">@Model.TotalAssignments</div>
        <div class="stat-label">Assignments <span class="stat-sub">@Model.PendingAssignments pending</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="Assignments" asp-action="Index">
        <div class="stat-icon stat-icon-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.2H22l-6 4.4 2.3 7.1L12 16.3 5.7 20.7 8 13.6l-6-4.4h7.6z"/></svg>
        </div>
        <div class="stat-value">@(Model.AverageGradeGiven != null ? $"{Model.AverageGradeGiven}%" : "—")</div>
        <div class="stat-label">Average Grade Given <span class="stat-sub">@Model.SubmissionsToGrade to grade</span></div>
    </a>
    <a class="stat-card stat-card-link" asp-controller="WeeklyChecklist" asp-action="Index">
        <div class="stat-icon stat-icon-slate">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="m3 6 1 1 2-2M3 12l1 1 2-2M3 18l1 1 2-2"/></svg>
        </div>
        <div class="stat-value">@Model.TotalWeeklyChecklists</div>
        <div class="stat-label">Weekly Checklist <span class="stat-sub">@Model.PendingWeeklyChecklists pending · @Model.MyPendingWeeklyChecklists yours</span></div>
    </a>
</div>

<div class="panel-grid">
    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">My Grades</h2>
            <a asp-controller="Students" asp-action="Index" class="panel-link">All my students</a>
        </div>
        <div class="panel-body">
            @if (!Model.Classes.Any())
            {
                <p class="empty-state">No grade assigned to you yet. Ask an admin to assign one.</p>
            }
            else
            {
                <ul class="entity-list">
                    @foreach (var grade in Model.Classes)
                    {
                        <li class="entity-list-item">
                            <a asp-controller="Students" asp-action="Index" asp-route-classId="@grade.Id">
                                <div>
                                    <div class="entity-title">@grade.Name</div>
                                    <div class="entity-meta">@Plural(grade.Count, "active student")</div>
                                </div>
                                <span class="panel-link">View students</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">My Subjects</h2>
            <a asp-controller="TeacherPortal" asp-action="MySubjects" class="panel-link">View all</a>
        </div>
        <div class="panel-body">
            @if (!Model.Subjects.Any())
            {
                <p class="empty-state">No subjects assigned to you yet. Ask an admin to assign you.</p>
            }
            else
            {
                <ul class="entity-list">
                    @foreach (var subject in Model.Subjects)
                    {
                        <li class="entity-list-item">
                            <a asp-controller="TeacherPortal" asp-action="AssignStudents" asp-route-subjectId="@subject.Id">
                                <div>
                                    <div class="entity-title">@subject.Name</div>
                                    <div class="entity-meta">@(subject.Count == 0 ? "Not linked to a grade yet" : $"Taught in {Plural(subject.Count, "grade")}")</div>
                                </div>
                                <span class="panel-link">Assign students</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="panel-grid">
    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">Upcoming Exams</h2>
            <a asp-controller="Exams" asp-action="Index" class="panel-link">View all</a>
        </div>
        <div class="panel-body">
            @if (!Model.UpcomingExams.Any())
            {
                <p class="empty-state">No scheduled exams coming up. <a asp-controller="Exams" asp-action="Create">Create an exam</a>.</p>
            }
            else
            {
                <ul class="entity-list">
                    @foreach (var exam in Model.UpcomingExams)
                    {
                        <li class="entity-list-item">
                            <a asp-controller="Exams" asp-action="Questions" asp-route-examId="@exam.Id">
                                <div>
                                    <div class="entity-title">@exam.Title</div>
                                    <div class="entity-meta">@exam.Subject?.Name &middot; @exam.Class?.Name &middot; @exam.StartDate!.Value.ToString("ddd d MMM, h:mm tt")</div>
                                </div>
                                <span class="status-badge status-@exam.Status.ToLower()">@exam.Status</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">Recent Assignments</h2>
            <a asp-controller="Assignments" asp-action="Index" class="panel-link">View all</a>
        </div>
        <div class="panel-body">
            @if (!Model.RecentAssignments.Any())
            {
                <p class="empty-state">No assignments for your subjects yet. <a asp-controller="Assignments" asp-action="Create">Create an assignment</a>.</p>
            }
            else
            {
                <ul class="entity-list">
                    @foreach (var assignment in Model.RecentAssignments)
                    {
                        <li class="entity-list-item">
                            <a asp-controller="Assignments" asp-action="Grade" asp-route-id="@assignment.Id">
                                <div>
                                    <div class="entity-title">@assignment.Title</div>
                                    <div class="entity-meta">@assignment.Subject?.Name &middot; Due @assignment.DueDate.ToShortDateString()</div>
                                </div>
                                <span class="status-badge status-@assignment.Status.ToLower().Replace(" ", "-")">@assignment.Status</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="panel-grid">
    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">Quick Actions</h2>
        </div>
        <div class="panel-body">
            <div class="quick-actions">
                <a class="quick-action" asp-controller="Attendance" asp-action="Create">Take Attendance</a>
                <a class="quick-action" asp-controller="Students" asp-action="Create">Enroll Student</a>
                <a class="quick-action" asp-controller="Exams" asp-action="Create">Create Exam</a>
                <a class="quick-action" asp-controller="Assignments" asp-action="Create">Create Assignment</a>
                <a class="quick-action" asp-controller="Assignments" asp-action="Index">Grade Submissions</a>
                <a class="quick-action" asp-controller="WeeklyChecklist" asp-action="Index">Weekly Checklist</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Password Reset";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="card-title mb-3">Password Reset Successful</h3>
                    <p class="text-muted">Your password has been updated. You can now log in with your new password.</p>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Invalid Reset Link";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="card-title mb-3">Invalid or Expired Link</h3>
                    <p class="text-muted">This password reset link is invalid, expired, or has already been used.</p>
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="btn btn-primary">Request a New Link</a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-secondary">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Reset Link Generated";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title text-center mb-3">Reset Link Generated</h3>
                    <p class="text-muted text-center">
                        This app doesn't send emails yet, so use the link below now to reset your password.
                        It expires in 1 hour and can only be used once.
                    </p>

                    <div class="alert alert-info text-break">
                        <a href="@ViewBag.ResetUrl">@ViewBag.ResetUrl</a>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-secondary">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

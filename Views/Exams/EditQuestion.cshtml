@model SchoolManagement.Models.ExamQuestion

@{
    ViewData["Title"] = "Edit Question";
    var exam = (SchoolManagement.Models.Exam)ViewBag.Exam;
}

<div class="mb-3">
    <a asp-action="Questions" asp-route-examId="@exam.Id" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Edit Question &mdash; @exam.Title</h2>

<form asp-action="EditQuestion">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExamId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="QuestionText" class="form-label"></label>
        <textarea asp-for="QuestionText" class="form-control" rows="3"></textarea>
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="OptionA" class="form-label"></label>
            <input asp-for="OptionA" class="form-control" />
            <span asp-validation-for="OptionA" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OptionB" class="form-label"></label>
            <input asp-for="OptionB" class="form-control" />
            <span asp-validation-for="OptionB" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OptionC" class="form-label"></label>
            <input asp-for="OptionC" class="form-control" />
            <span asp-validation-for="OptionC" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OptionD" class="form-label"></label>
            <input asp-for="OptionD" class="form-control" />
            <span asp-validation-for="OptionD" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CorrectOption" class="form-label">Correct Answer</label>
            <select asp-for="CorrectOption" class="form-select">
                <option value="A">Option A</option>
                <option value="B">Option B</option>
                <option value="C">Option C</option>
                <option value="D">Option D</option>
            </select>
            <span asp-validation-for="CorrectOption" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Questions" asp-route-examId="@exam.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>

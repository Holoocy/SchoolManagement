@model IEnumerable<SchoolManagement.Models.ExamSubmission>

@{
    ViewData["Title"] = "Exam Results";
    var exam = (SchoolManagement.Models.Exam)ViewBag.Exam;
    var canMark = (bool)(ViewBag.CanMark ?? false);
    var awaiting = Model.Count(s => s.AwaitingMarking);
    var hasWrittenQuestions = exam.Questions.Any(q => q.IsManuallyMarked);
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>@exam.Title &mdash; Results</h2>
<p class="text-muted">@exam.Subject?.Name &middot; @exam.Class?.Name</p>

@if (TempData["ExamSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ExamSuccess"]</div>
}
@if (awaiting > 0)
{
    <div class="alert alert-warning">@awaiting submission(s) have written answers waiting to be marked.</div>
}

@if (!Model.Any())
{
    <p class="empty-state">No students have taken this exam yet.</p>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Score</th>
                <th>Marking</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Student?.FullName</td>
                    <td>@s.Score / @s.OutOf <span class="text-muted small">(@s.Percentage%)</span></td>
                    <td>
                        @if (s.AwaitingMarking)
                        {
                            <span class="status-badge status-pending">Awaiting marking</span>
                        }
                        else
                        {
                            <span class="status-badge status-completed">Marked</span>
                        }
                    </td>
                    <td>@s.SubmittedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-nowrap">
                        @if (canMark && hasWrittenQuestions && s.Answers.Any())
                        {
                            <a class="btn btn-sm btn-primary" asp-action="Mark" asp-route-id="@s.Id">@(s.AwaitingMarking ? "Mark" : "Review marks")</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

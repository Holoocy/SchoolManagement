@model SchoolManagement.Models.Exam

@{
    ViewData["Title"] = "Create Exam";
}

<div class="entity-form-page entity-form-page--compact">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Assessment planning</p><h1>Create an exam</h1><p>Choose the assessment context before adding the exam questions.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to exams</a></header>
    <form method="post" asp-action="Create" class="entity-form-card">
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="exam-scope-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="exam-scope-heading">Exam scope</h2><p>Set a clear title and connect the exam to the correct subject and grade.</p></div></div><div class="entity-form-grid"><div class="entity-form-field entity-form-field--wide"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="SubjectId" class="form-label">Subject</label><select asp-for="SubjectId" class="form-select" asp-items="ViewBag.Subjects"><option value="">-- Select Subject --</option></select><span asp-validation-for="SubjectId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="ClassId" class="form-label">Grade</label><select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes"><option value="">-- Select Grade --</option></select><span asp-validation-for="ClassId" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>You can add questions immediately after creating the exam.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Create and add questions</button></div></footer>
    </form>
</div>

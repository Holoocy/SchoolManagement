@model IEnumerable<SchoolManagement.Models.Exam>

@{
    ViewData["Title"] = "Exams Approval";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">Exams Approval</h2>
    </div>
</div>

<nav class="nav nav-tabs" aria-label="Exams">
    <a class="nav-link active" aria-current="page" asp-action="PendingApproval">Exams Approval</a>
    <a class="nav-link" asp-action="AllExams">All Exams</a>
</nav>

@if (TempData["ExamSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ExamSuccess"]</div>
}

@if (!Model.Any())
{
    <p class="empty-state">No exams are waiting for approval.</p>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Teacher</th>
                <th>Subject</th>
                <th>Grade</th>
                <th>Questions</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exam in Model)
            {
                <tr>
                    <td>@exam.Title</td>
                    <td>@exam.Teacher?.FullName</td>
                    <td>@exam.Subject?.Name</td>
                    <td>@exam.Class?.Name</td>
                    <td>@exam.Questions.Count</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="ReviewDetails" asp-route-id="@exam.Id">Review</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@model SchoolManagement.Models.Exam

@{
    ViewData["Title"] = "Edit Exam";
}

<div class="entity-form-page entity-form-page--compact">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Assessment planning</p><h1>Edit exam</h1><p>Update the exam's title, subject or grade.</p></div><a asp-action="Questions" asp-route-examId="@Model.Id" class="entity-form-back-link">← Back to questions</a></header>

    @if (Model.Status == SchoolManagement.Models.ExamStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
    {
        <div class="alert alert-danger"><strong>Rejected by Admin:</strong> @Model.RejectionReason</div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="entity-form-card">
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="exam-scope-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="exam-scope-heading">Exam scope</h2><p>Set a clear title and connect the exam to the correct subject and grade.</p></div></div><div class="entity-form-grid"><div class="entity-form-field entity-form-field--wide"><label asp-for="Title" class="form-label"></label><input asp-for="Title" name="title" class="form-control" autofocus /><span asp-validation-for="Title" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="SubjectId" class="form-label">Subject</label><select asp-for="SubjectId" name="subjectId" class="form-select" asp-items="ViewBag.Subjects"><option value="">-- Select Subject --</option></select><span asp-validation-for="SubjectId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="ClassId" class="form-label">Grade</label><select asp-for="ClassId" name="classId" class="form-select" asp-items="ViewBag.Classes"><option value="">-- Select Grade --</option></select><span asp-validation-for="ClassId" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>@(Model.Status == SchoolManagement.Models.ExamStatus.Rejected ? "After saving, fix the questions and submit the exam for approval again." : "You can keep editing until you submit the exam for approval.")</span><div><a asp-action="Questions" asp-route-examId="@Model.Id" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

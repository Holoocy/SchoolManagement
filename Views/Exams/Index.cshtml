@model IEnumerable<SchoolManagement.Models.Exam>

@{
    ViewData["Title"] = "Exams";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">Exams</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create Exam</a>
</div>

@if (TempData["ExamSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ExamSuccess"]</div>
}
@if (TempData["ExamError"] != null)
{
    <div class="alert alert-danger">@TempData["ExamError"]</div>
}

@if (!Model.Any())
{
    <p class="empty-state">You haven't created any exams yet.</p>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Subject</th>
                <th>Grade</th>
                <th>Schedule</th>
                <th>Questions</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exam in Model)
            {
                <tr>
                    <td>@exam.Title</td>
                    <td>@exam.Subject?.Name</td>
                    <td>@exam.Class?.Name</td>
                    <td class="text-nowrap">
                        @if (exam.StartDate != null)
                        {
                            <div>@exam.StartDate.Value.ToString("ddd d MMM yyyy, h:mm tt")</div>
                            <div class="text-muted small">@(exam.DurationMinutes != null ? SchoolManagement.Services.ExamNotices.Duration(exam.DurationMinutes.Value) : "No duration set")</div>
                        }
                        else
                        {
                            <span class="text-muted">Not scheduled</span>
                        }
                    </td>
                    <td>@exam.Questions.Count</td>
                    <td>
                        <span class="status-badge status-@exam.Status.ToLower()">@exam.Status</span>
                        @if (exam.Status == "Rejected" && !string.IsNullOrWhiteSpace(exam.RejectionReason))
                        {
                            <div class="text-muted small">@exam.RejectionReason</div>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Questions" asp-route-examId="@exam.Id">Questions</a>
                        @if (exam.Status == "Draft" || exam.Status == "Rejected")
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@exam.Id">Edit</a>
                            <form method="post" asp-action="SubmitForApproval" asp-route-id="@exam.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Submit for Approval</button>
                            </form>
                        }
                        @if (exam.Status == "Approved")
                        {
                            <form method="post" asp-action="Publish" asp-route-id="@exam.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Send to Students</button>
                            </form>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Notify" asp-route-id="@exam.Id">Schedule &amp; Notify</a>
                        }
                        @if (exam.Status == "Published")
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Notify" asp-route-id="@exam.Id">Schedule &amp; Notify</a>
                            <a class="btn btn-sm btn-outline-info" asp-action="Results" asp-route-id="@exam.Id">Results</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

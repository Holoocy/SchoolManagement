@model SchoolManagement.Models.Exam

@{
    ViewData["Title"] = "Review Exam";
}

<div class="mb-3">
    <a asp-action="PendingApproval" class="btn btn-outline-secondary">Back</a>
</div>

<h2>@Model.Title</h2>
<p class="text-muted">
    By @Model.Teacher?.FullName &middot; @Model.Subject?.Name &middot; @Model.Class?.Name
    &middot; <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
</p>

@if (!Model.Questions.Any())
{
    <p class="text-muted">This exam has no questions.</p>
}
else
{
    <ol class="list-group list-group-numbered mb-4">
        @foreach (var q in Model.Questions)
        {
            <li class="list-group-item">
                <partial name="_QuestionSummary" model="q" />
            </li>
        }
    </ol>
}

@if (Model.Status == "PendingApproval")
{
    <div class="row g-3">
        <div class="col-md-6">
            <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Approve</button>
            </form>
        </div>
        <div class="col-md-6">
            <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-auto flex-grow-1">
                    <input type="text" name="reason" class="form-control" placeholder="Reason for rejection (optional)" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
}

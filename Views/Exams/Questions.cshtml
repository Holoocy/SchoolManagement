@model SchoolManagement.Models.Exam

@{
    ViewData["Title"] = "Exam Questions";
    var canEdit = Model.Status == "Draft" || Model.Status == "Rejected";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>@Model.Title</h2>
<p class="text-muted">@Model.Subject?.Name &middot; @Model.Class?.Name &middot; <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
    @if (Model.Questions.Any())
    {
        <text>&middot; @Model.Questions.Count question(s), @Model.Questions.Sum(q => q.Marks) marks in total</text>
    }
</p>

@if (TempData["ExamSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ExamSuccess"]</div>
}
@if (TempData["ExamError"] != null)
{
    <div class="alert alert-danger">@TempData["ExamError"]</div>
}

@if (Model.Status == "Rejected")
{
    <div class="alert alert-danger">
        <strong>Rejected by Admin@(string.IsNullOrWhiteSpace(Model.RejectionReason) ? "." : ":")</strong> @Model.RejectionReason
        <div class="small mt-1">Edit the exam or its questions, then submit it for approval again.</div>
    </div>
}

@if (!canEdit)
{
    <p class="text-muted">Questions can no longer be changed while the exam is awaiting approval or after it has been approved.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary" asp-action="AddQuestion" asp-route-examId="@Model.Id">Add Question</a>
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit exam details</a>
    </div>
}

@if (!Model.Questions.Any())
{
    <p class="text-muted">No questions added yet.</p>
}
else
{
    <ol class="list-group list-group-numbered">
        @foreach (var q in Model.Questions)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <partial name="_QuestionSummary" model="q" />
                    @if (canEdit)
                    {
                        <div class="text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditQuestion" asp-route-id="@q.Id">Edit</a>
                            <form method="post" asp-action="DeleteQuestion" asp-route-id="@q.Id" asp-route-examId="@Model.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </li>
        }
    </ol>
}

@if (canEdit && Model.Questions.Any())
{
    <form method="post" asp-action="SubmitForApproval" asp-route-id="@Model.Id" class="mt-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Submit for Approval</button>
    </form>
}

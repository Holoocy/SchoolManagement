@model SchoolManagement.Models.Exam

@{
    ViewData["Title"] = "Notify Start Date";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Notify Start Date &mdash; @Model.Title</h2>
<p class="text-muted">This sends a message with the exam's start date to every student in @Model.Class?.Name and their parents.</p>

<form method="post" asp-action="Notify" asp-route-id="@Model.Id" style="max-width: 420px;">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="startDate" class="form-label">Exam Start Date</label>
        <input type="date" name="startDate" id="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" required />
    </div>

    <button type="submit" class="btn btn-primary">Send Notification</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

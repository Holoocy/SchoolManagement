@model IEnumerable<SchoolManagement.Models.Teacher>
@{
    var subject = (SchoolManagement.Models.Subject)ViewBag.Subject;
    var assignedIds = (List<int>)ViewBag.AssignedIds;
    ViewData["Title"] = "Assign Teachers";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@subject.Id" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Assign Teachers</h2>
<p class="text-muted">Select the teachers who teach <strong>@subject.Name</strong>.</p>

<form asp-action="AssignTeachers" asp-route-id="@subject.Id" method="post">
    <div class="row g-2 mb-3">
        @foreach (var teacher in Model)
        {
            <div class="col-md-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="selectedIds" value="@teacher.Id" id="teacher-@teacher.Id" checked="@(assignedIds.Contains(teacher.Id) ? "checked" : null)" />
                    <label class="form-check-label" for="teacher-@teacher.Id">@teacher.FullName</label>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@subject.Id" class="btn btn-secondary">Cancel</a>
</form>

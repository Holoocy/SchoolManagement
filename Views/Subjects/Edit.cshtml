@model SchoolManagement.Models.Subject

@{
    ViewData["Title"] = "Edit Subject";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Academic catalogue</p><h1>Edit subject</h1><p>Refine this subject’s information and availability.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to subjects</a></header>
    <form method="post" asp-action="Edit" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="subject-core-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="subject-core-heading">Subject information</h2><p>Review the name, code, credit value, and availability.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" autofocus /><span asp-validation-for="Name" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Credits" class="form-label"></label><input asp-for="Credits" class="form-control" /><span asp-validation-for="Credits" class="field-validation-error"></span></div><label class="entity-form-active-option"><input asp-for="IsActive" class="form-check-input" /><span><strong>Active subject</strong><small>Make this subject available for school activities.</small></span></label></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="subject-description-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="subject-description-heading">Teaching overview</h2><p>Describe the subject so staff can identify its purpose.</p></div></div><div class="entity-form-grid"><div class="entity-form-field entity-form-field--wide"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>Changes appear in the school’s academic catalogue.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

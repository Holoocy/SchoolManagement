@model IEnumerable<SchoolManagement.Models.Subject>
@{
    var teacher = (SchoolManagement.Models.Teacher)ViewBag.Teacher;
    var assignedIds = (List<int>)ViewBag.AssignedIds;
    ViewData["Title"] = "Assign Subjects";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Assign Subjects</h2>
<p class="text-muted">Select the subjects <strong>@teacher.FullName</strong> teaches.</p>

<form asp-action="AssignSubjects" asp-route-id="@teacher.Id" method="post">
    <div class="row g-2 mb-3">
        @foreach (var subject in Model)
        {
            <div class="col-md-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="selectedIds" value="@subject.Id" id="subject-@subject.Id" checked="@(assignedIds.Contains(subject.Id) ? "checked" : null)" />
                    <label class="form-check-label" for="subject-@subject.Id">@subject.Name</label>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-secondary">Cancel</a>
</form>

@model IEnumerable<SchoolManagement.Models.Class>
@{
    var teacher = (SchoolManagement.Models.Teacher)ViewBag.Teacher;
    var assignedIds = (List<int>)ViewBag.AssignedIds;
    ViewData["Title"] = "Assign Classes";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Assign Classes</h2>
<p class="text-muted">Select the classes <strong>@teacher.FullName</strong> is assigned to.</p>

<form asp-action="AssignClasses" asp-route-id="@teacher.Id" method="post">
    <div class="row g-2 mb-3">
        @foreach (var classItem in Model)
        {
            <div class="col-md-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="selectedIds" value="@classItem.Id" id="class-@classItem.Id" checked="@(assignedIds.Contains(classItem.Id) ? "checked" : null)" />
                    <label class="form-check-label" for="class-@classItem.Id">@classItem.Name</label>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-secondary">Cancel</a>
</form>

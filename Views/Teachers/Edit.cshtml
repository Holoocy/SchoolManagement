@model SchoolManagement.Models.Teacher

@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Faculty directory</p><h1>Edit teacher</h1><p>Update this teacher’s directory, contact, and employment details.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to teachers</a></header>
    <form method="post" asp-action="Edit" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="teacher-identity-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="teacher-identity-heading">Teacher identity</h2><p>Use the name and staff reference shown in the school directory.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus /><span asp-validation-for="FirstName" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="EmployeeId" class="form-label"></label><input asp-for="EmployeeId" class="form-control" /><span asp-validation-for="EmployeeId" class="field-validation-error"></span></div><fieldset class="entity-form-field entity-form-choice-field"><legend class="form-label">Gender</legend><div class="entity-form-choice-group"><label><input type="radio" name="Gender" id="genderMale" value="Male" autocomplete="off" checked="@(Model?.Gender == "Male" ? "checked" : null)" /><span>Male</span></label><label><input type="radio" name="Gender" id="genderFemale" value="Female" autocomplete="off" checked="@(Model?.Gender == "Female" ? "checked" : null)" /><span>Female</span></label></div><span asp-validation-for="Gender" class="field-validation-error"></span></fieldset></div></section>
        <section class="entity-form-section" aria-labelledby="teacher-contact-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="teacher-contact-heading">Contact details</h2><p>Keep this information current for school communications.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="field-validation-error"></span></div><div class="entity-form-field entity-form-field--wide"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" autocomplete="street-address" rows="3"></textarea><span asp-validation-for="Address" class="field-validation-error"></span></div></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="teacher-employment-heading"><div class="entity-form-section-heading"><span>03</span><div><h2 id="teacher-employment-heading">Employment status</h2><p>Review the start date and whether this teacher is active.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="HireDate" class="form-label"></label><input asp-for="HireDate" class="form-control" /><span asp-validation-for="HireDate" class="field-validation-error"></span></div><label class="entity-form-active-option"><input asp-for="IsActive" class="form-check-input" /><span><strong>Active teacher</strong><small>Allow participation in school activities.</small></span></label></div></section>
        <footer class="entity-form-actions"><span>Changes are applied to this teacher’s school record.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

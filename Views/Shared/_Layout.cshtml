@inject SchoolManagement.Services.ITenantProvider TenantProvider
@{
    var fullName = User.FindFirst("FullName")?.Value;
    var roleNames = string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
    // Every resolved school has a selected theme color. Apply it to the shared
    // design tokens so all portal surfaces respect that school's branding.
    var hasTenantTheme = TenantProvider.IsResolved
        && !string.IsNullOrWhiteSpace(TenantProvider.ThemeColor);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14201c" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <title>@ViewData["Title"] - @(TenantProvider.SchoolName ?? "SchoolManagement")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/choices/choices.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagement.styles.css" asp-append-version="true" />
    @if (hasTenantTheme)
    {
        <style>
            :root {
                /* The school picks one color; button hover, sidebar tint and soft
                   backgrounds are all derived from it so they stay visually in sync
                   without needing separate color pickers for each. */
                --color-accent: @TenantProvider.ThemeColor;
                --color-accent-dark: color-mix(in srgb, @TenantProvider.ThemeColor 82%, black);
                --color-accent-soft: color-mix(in srgb, @TenantProvider.ThemeColor 12%, white);
                --color-sidebar-bg: color-mix(in srgb, @TenantProvider.ThemeColor 12%, #111614);
            }
        </style>
    }
</head>
<body class="@((User.Identity?.IsAuthenticated ?? false) && TenantProvider.IsResolved ? "has-shell" : "auth-body")">
    @if ((User.Identity?.IsAuthenticated ?? false) && TenantProvider.IsResolved)
    {
        <div class="app-shell">
            @await Html.PartialAsync("_Sidebar")
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <div class="app-main">
                <header class="topbar">
                    <div class="topbar-accent-line"></div>
                    <button class="sidebar-toggle header-icon-btn" type="button" id="sidebarToggle" aria-label="Toggle navigation">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <div class="topbar-heading">
                        <div class="topbar-title">@ViewData["Title"]</div>
                        <div class="topbar-breadcrumb">
                            <a asp-controller="Dashboard" asp-action="Index">@(TenantProvider.SchoolName ?? "Home")</a>
                            <span>/</span>
                            <span>@ViewData["Title"]</span>
                        </div>
                    </div>
                    <div class="topbar-actions">
                        <a class="header-icon-btn" asp-controller="Messages" asp-action="Index" aria-label="Messages" title="Messages">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </a>
                        <a class="header-icon-btn" asp-controller="Settings" asp-action="Index" aria-label="Settings" title="Settings">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        </a>
                        <span class="topbar-divider"></span>
                        <div class="topbar-user dropdown">
                            <a class="topbar-user-toggle dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="topbar-user-avatar">@(fullName?.Substring(0, 1).ToUpper())<span class="topbar-user-status"></span></span>
                                <span class="topbar-user-meta">
                                    <span class="topbar-user-name">@fullName</span>
                                    <span class="topbar-user-role">@roleNames</span>
                                </span>
                                <svg class="topbar-user-caret" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li class="dropdown-user-card">
                                    <span class="topbar-user-avatar">@(fullName?.Substring(0, 1).ToUpper())</span>
                                    <span>
                                        <span class="d-block fw-bold">@fullName</span>
                                        <span class="d-block dropdown-user-role">@roleNames</span>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">Settings</a></li>
                                <li>
                                    <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main role="main" class="content-area">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    &copy; 2026 - @(TenantProvider.SchoolName ?? "SchoolManagement") - <a asp-controller="Dashboard" asp-action="Privacy">Privacy</a>
                </footer>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="auth-main">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/choices/choices.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if ((User.Identity?.IsAuthenticated ?? false) && TenantProvider.IsResolved)
    {
        <script>
            (function () {
                var sidebar = document.getElementById('sidebar');
                var backdrop = document.getElementById('sidebarBackdrop');
                function toggle(open) {
                    sidebar?.classList.toggle('open', open);
                    backdrop?.classList.toggle('show', open);
                }
                document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                    toggle(!sidebar?.classList.contains('open'));
                });
                backdrop?.addEventListener('click', function () { toggle(false); });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model SchoolManagement.Models.EmptyStateViewModel

<section class="classic-empty-state" aria-labelledby="empty-state-title">
    <span class="classic-empty-state-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 7.5h16M7.5 4v3.5M16.5 4v3.5M5.5 5.5h13A1.5 1.5 0 0 1 20 7v11.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5V7A1.5 1.5 0 0 1 5.5 5.5Z" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M9 13h6M12 10v6" stroke-linecap="round" />
        </svg>
    </span>
    <div class="classic-empty-state-copy">
        <h3 id="empty-state-title">@Model.Title</h3>
        <p>@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.Action) && !string.IsNullOrWhiteSpace(Model.ActionText))
        {
            <a asp-action="@Model.Action" class="btn btn-primary classic-empty-state-action">@Model.ActionText</a>
        }
    </div>
</section>

@model SchoolManagement.Models.WeeklyChecklistItem

@{
    ViewData["Title"] = "Edit Checklist Item";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Weekly checklist</p><h1>Edit checklist item</h1><p>Update the work item, responsibility, and supporting material.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to checklist</a></header>
    <form method="post" asp-action="Edit" enctype="multipart/form-data" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="checklist-details-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="checklist-details-heading">Work item</h2><p>Review the task, schedule, ownership, and status.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="field-validation-error"></span></div>@if (User.IsInRole("Admin")){<div class="entity-form-field"><label asp-for="AssignedTo" class="form-label"></label><select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.TeacherNames"><option value="">-- Select Teacher --</option></select><span asp-validation-for="AssignedTo" class="field-validation-error"></span></div>}<div class="entity-form-field"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="In Progress">In Progress</option><option value="Done">Done</option></select><span asp-validation-for="Status" class="field-validation-error"></span></div><div class="entity-form-field entity-form-field--wide"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="checklist-document-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="checklist-document-heading">Supporting document</h2><p>Replace the current file only when an updated document is needed.</p></div></div><div class="entity-form-grid"><div class="entity-form-field entity-form-upload-panel"><label class="form-label">Document @(Model.DocumentPath != null && (bool)ViewBag.CanSeeDocument ? "(replace)" : "(optional)")</label>@if (Model.DocumentPath != null && (bool)ViewBag.CanSeeDocument){<a href="@Model.DocumentPath" target="_blank" class="entity-form-current-document">View current document</a>}<input type="file" name="documentFile" class="form-control" /><small>Leave this empty to retain the existing document.</small></div><div class="entity-form-field"><label class="form-label">Document Visible To</label><select asp-for="DocumentVisibility" class="form-select"><option value="TeacherOnly">Teacher Only</option><option value="Admin">Admin</option></select></div></div></section>
        <footer class="entity-form-actions"><span>Changes are saved to this weekly checklist item.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

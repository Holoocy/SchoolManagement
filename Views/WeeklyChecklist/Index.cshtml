@model IEnumerable<SchoolManagement.Models.WeeklyChecklistItem>

@{
    ViewData["Title"] = "Weekly Checklist";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">Weekly Checklist</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Item</a>
</div>

@if (!Model.Any())
{
    @await Html.PartialAsync("_ClassicEmptyState", new SchoolManagement.Models.EmptyStateViewModel
    {
        Title = "Plan the week with clarity",
        Description = "Add your first checklist item to keep important school work visible and on track.",
        Action = "Create",
        ActionText = "Add a checklist item"
    })
}
else
{
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Assigned To</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Document</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            var visibleDocumentIds = (HashSet<int>)ViewBag.VisibleDocumentIds;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.AssignedTo</td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>
                    @if (visibleDocumentIds.Contains(item.Id))
                    {
                        <a href="@item.DocumentPath" target="_blank">View</a>
                    }
                    else if (item.DocumentPath != null)
                    {
                        <span class="text-muted small">Private</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">View</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
}

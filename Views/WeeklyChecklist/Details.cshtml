@model SchoolManagement.Models.WeeklyChecklistItem

@{
    ViewData["Title"] = "Checklist Item Details";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<h2>Checklist Item Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@Model.AssignedTo</dd>
            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@Model.DueDate.ToShortDateString()</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            @if ((bool)ViewBag.CanSeeDocument)
            {
                <dt class="col-sm-3">Document</dt>
                <dd class="col-sm-9"><a href="@Model.DocumentPath" target="_blank">View document</a></dd>
            }
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

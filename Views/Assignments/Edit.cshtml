@model SchoolManagement.Models.Assignment

@{
    ViewData["Title"] = "Edit Assignment";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Learning activities</p><h1>Edit assignment</h1><p>Keep the assignment brief, due date, and progress status up to date.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to assignments</a></header>
    <form method="post" asp-action="Edit" class="entity-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="assignment-context-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="assignment-context-heading">Assignment context</h2><p>Choose the subject and set a clear title for this activity.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="SubjectId" class="form-label"></label><select asp-for="SubjectId" class="form-select" asp-items="ViewBag.Subjects"><option value="">-- Select Subject --</option></select><span asp-validation-for="SubjectId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="ClassId" class="form-label">Grade</label><select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes"><option value="">-- Select Grade --</option></select><div class="entity-form-hint">Every student in this grade will see the assignment.</div><span asp-validation-for="ClassId" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="field-validation-error"></span></div></div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="assignment-details-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="assignment-details-heading">Schedule and details</h2><p>Set the delivery date, current status, and instructions.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="In Progress">In Progress</option><option value="Done">Done</option></select><span asp-validation-for="Status" class="field-validation-error"></span></div><div class="entity-form-field entity-form-field--wide"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>Students will see the updated assignment details.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes</button></div></footer>
    </form>
</div>

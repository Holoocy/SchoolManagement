@model SchoolManagement.Models.Assignment

@{
    ViewData["Title"] = "Create Assignment";
}

<div class="entity-form-page">
    <header class="entity-form-header"><div><p class="entity-form-eyebrow">Learning activities</p><h1>Create an assignment</h1><p>Set a focused learning activity with a clear subject, schedule, and brief.</p></div><a asp-action="Index" class="entity-form-back-link">← Back to assignments</a></header>
    <form method="post" asp-action="Create" class="entity-form-card">
        <div asp-validation-summary="ModelOnly" class="entity-form-error-summary" role="alert"></div>
        <section class="entity-form-section" aria-labelledby="assignment-context-heading"><div class="entity-form-section-heading"><span>01</span><div><h2 id="assignment-context-heading">Assignment context</h2><p>Set the owner and subject before naming the learning activity.</p></div></div><div class="entity-form-grid">
            @if (User.IsInRole("Admin"))
            {
                <div class="entity-form-field"><label class="form-label">Teacher</label><select class="form-select" id="teacherSelect" asp-items="ViewBag.Teachers" data-no-choices><option value="">-- Select Teacher --</option></select><div class="entity-form-hint">Choose a teacher first to narrow the subject list below.</div></div>
            }
            <div class="entity-form-field"><label asp-for="SubjectId" class="form-label"></label><select asp-for="SubjectId" class="form-select" asp-items="ViewBag.Subjects" id="subjectSelect" data-no-choices><option value="">-- Select Subject --</option></select><span asp-validation-for="SubjectId" class="field-validation-error"></span></div>
            <div class="entity-form-field"><label asp-for="ClassId" class="form-label">Grade</label><select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes"><option value="">-- Select Grade --</option></select><div class="entity-form-hint">Every student in this grade will see the assignment.</div><span asp-validation-for="ClassId" class="field-validation-error"></span></div>
            <div class="entity-form-field"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="field-validation-error"></span></div>
        </div></section>
        <section class="entity-form-section entity-form-section--last" aria-labelledby="assignment-details-heading"><div class="entity-form-section-heading"><span>02</span><div><h2 id="assignment-details-heading">Schedule and details</h2><p>Provide the delivery date, initial status, and instructions for students.</p></div></div><div class="entity-form-grid"><div class="entity-form-field"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="MaxScore" class="form-label">Total marks</label><input asp-for="MaxScore" type="number" min="1" max="1000" class="form-control" /><div class="entity-form-hint">Scores are given out of this. All of a student's assignment scores in the subject are added up and scaled to the Assignment part of their result.</div><span asp-validation-for="MaxScore" class="field-validation-error"></span></div><div class="entity-form-field"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="In Progress">In Progress</option><option value="Done">Done</option></select><span asp-validation-for="Status" class="field-validation-error"></span></div><div class="entity-form-field entity-form-field--wide"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div></div></section>
        <footer class="entity-form-actions"><span>Review the assignment details before publishing.</span><div><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Create assignment</button></div></footer>
    </form>
</div>

@if (User.IsInRole("Admin"))
{
    <script>
        (function () {
            var teacherSubjectMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TeacherSubjectIds));
            var teacherSelect = document.getElementById('teacherSelect');
            var subjectSelect = document.getElementById('subjectSelect');
            var allOptions = Array.prototype.slice.call(subjectSelect.options);

            teacherSelect.addEventListener('change', function () {
                var teacherId = teacherSelect.value;
                var allowedIds = teacherId && teacherSubjectMap[teacherId] ? teacherSubjectMap[teacherId].map(String) : null;

                subjectSelect.innerHTML = '';
                allOptions.forEach(function (opt) {
                    if (!opt.value || !allowedIds || allowedIds.indexOf(opt.value) !== -1) {
                        subjectSelect.appendChild(opt.cloneNode(true));
                    }
                });
            });
        })();
    </script>
}

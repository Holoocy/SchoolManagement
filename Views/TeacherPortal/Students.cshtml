@model IEnumerable<SchoolManagement.Models.Student>

@{
    ViewData["Title"] = "My Students";
    var classes = (List<SchoolManagement.Controllers.ClassPickerItem>)ViewBag.Classes;
    int? selectedClassId = ViewBag.SelectedClassId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="history.back()">Back</button>
        <h2 class="mb-0">My Students</h2>
        <p class="text-muted small mb-0">Students in the grade(s) assigned to you.</p>
    </div>
    @if (selectedClassId != null)
    {
        <a class="btn btn-primary" asp-action="CreateStudent">Enroll Student</a>
    }
</div>

@if (TempData["TeacherPortalSuccess"] != null)
{
    <div class="alert alert-success">@TempData["TeacherPortalSuccess"]</div>
}
@if (TempData["TeacherPortalError"] != null)
{
    <div class="alert alert-danger">@TempData["TeacherPortalError"]</div>
}

@if (!classes.Any())
{
    <p class="text-muted">No grade(s) have been assigned to you yet.</p>
}
else if (selectedClassId == null)
{
    <p class="text-muted">You are assigned to more than one grade. Choose one to view its students.</p>
    <div class="row g-3">
        @foreach (var c in classes)
        {
            <div class="col-md-4">
                <a asp-action="Students" asp-route-classId="@c.Id" class="text-decoration-none">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-1">@c.Name</h5>
                            <p class="text-muted mb-0">@c.StudentCount student(s)</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    @if (classes.Count > 1)
    {
        <p class="mb-3"><a asp-action="Students">&larr; Choose a different grade</a></p>
    }

    if (!Model.Any())
    {
        <p class="text-muted">No students in this grade yet.</p>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Admission No.</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AdmissionNumber</td>
                        <td>@item.FullName</td>
                        <td>@(item.Class?.Name ?? "—")</td>
                        <td>@item.Email</td>
                        <td><a class="btn btn-sm btn-outline-secondary" asp-action="TransferStudent" asp-route-id="@item.Id">Transfer</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
